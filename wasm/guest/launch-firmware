#!/bin/sh
set -eu
log() { echo "Q2_FW [$1] $2"; }
fail() { log ERROR "$*"; exit 1; }
lower=/mnt/q2-lower
root=/mnt/q2
mkdir -p "$lower" "$root" /mnt/q2-write
log DISK "Available block devices:"
cat /proc/partitions
disk=
for attempt in 1 2 3 4 5; do
    for candidate in /dev/sda /dev/hda; do
        if [ -b "$candidate" ] && mount -t squashfs -o ro "$candidate" "$lower"; then disk=$candidate; break; fi
    done
    [ -z "$disk" ] || break
    sleep 1
done
[ -n "$disk" ] || fail "SquashFS mount failed"
log MOUNT "Read-only firmware mounted from $disk"
echo Q2_FIRMWARE_MOUNTED
mount -t tmpfs -o size=32m tmpfs /mnt/q2-write || fail "tmpfs mount failed"
mkdir -p /mnt/q2-write/upper /mnt/q2-write/work
mount -t overlay overlay -o lowerdir="$lower",upperdir=/mnt/q2-write/upper,workdir=/mnt/q2-write/work "$root" || fail "overlay mount failed"
log OVERLAY "Writable ephemeral firmware filesystem ready"
[ -x "$root/release/bin/demo" ] || fail "demo executable not found"
# Opening the binary for writing triggers OverlayFS copy-up before patching.
backlight=$(/bin/firmware-patch "$root/release/bin/demo") || fail "Firmware compatibility patch failed"
log PATCH "Serial gate patched; backlight symbol $backlight"
log ABI "Firmware ELF header (first 52 bytes):"
od -An -tx1 -N52 "$root/release/bin/demo"
log ABI "Guest CPU and memory:"
cat /proc/cpuinfo /proc/meminfo
mkdir -p "$root/dev/input" "$root/tmp/q2emu" "$root/var/run/dbus" "$root/mnt/data" "$root/mnt/mmc" "$root/proc"
mount --bind /proc "$root/proc" || fail "proc bind mount failed"
# Preserve synthetic sysfs files rather than mounting the real guest sysfs over them.
mkdir -p "$root/sys/devices/i2c-0/0-0062" "$root/sys/class/power_supply/battery"
echo 100 > "$root/sys/devices/i2c-0/0-0062/cw2015_capacity"
echo 4200 > "$root/sys/devices/i2c-0/0-0062/cw2015_voltage"
echo Full > "$root/sys/class/power_supply/battery/status"
for name in null zero random urandom tty; do
    touch "$root/dev/$name"
    mount --bind "/dev/$name" "$root/dev/$name" || fail "bind $name failed"
done
rm -f "$root/dev/fb0"
truncate -s 960000 "$root/dev/fb0"
for name in mcu shanling_dac input/event1 input/event2 input/event3 input/event4; do
    rm -f "$root/dev/$name"
    touch "$root/dev/$name"
done
mount -t 9p -o trans=virtio,version=9p2000.L,cache=none q2sd "$root/mnt/mmc" || fail "Virtual SD mount failed"
for name in mmcblk4 mmcblk4p0 mmcblk4p1 mmcblk4p2 mmcblk4p3 mmcblk4p4 mmcblk4p5 mmcblk4p6 mmcblk4p7 mmcblk4p8 mmcblk4p9; do
    rm -f "$root/dev/$name"
    touch "$root/dev/$name"
done
touch "$root/tmp/mmc_add"
log SD "Virtual SD mounted at /mnt/mmc"
df -k "$root/mnt/mmc" || true
echo Q2_SD_READY
log DEVICES "Framebuffer and device stand-ins created"
[ -f /q2/libq2emu.so ] || fail "Prebuilt shim missing"
cp /q2/libq2emu.so "$root/lib/libq2emu.so"
cp /q2/hardware-bridge "$root/tmp/q2emu/hardware-bridge"
mkdir -p "$root/usr/share/alsa/alsa.conf.d"
printf 'pcm.!default { type null }\n' > "$root/usr/share/alsa/alsa.conf.d/99-q2emu.conf"
# Stand-ins mirror desktop behavior for absent hardware. Only replace the guest copy.
standin() {
    path="$root/$1"
    shift
    if [ -e "$path" ] || [ -L "$path" ]; then
        mv "$path" "$path.q2emu-orig"
        printf '#!/bin/sh\n%s\n' "$*" > "$path"
        chmod 755 "$path"
    fi
}
standin usr/bin/checkappprocess.sh 'while :; do sleep 3600; done'
standin usr/bin/rtk_hciattach 'touch /tmp/rtk_init_success; while :; do sleep 3600; done'
standin usr/bin/hciconfig 'exit 0'
log SHIM "Installed shim and watchdog/Bluetooth stand-ins; ABI compatibility not assumed"
mkdir -p "$root/tmp/q2bridge"
mount -t 9p -o trans=virtio,version=9p2000.L,cache=none q2bridge "$root/tmp/q2bridge" || fail "9p hardware transport mount failed"
chroot "$root" /tmp/q2emu/hardware-bridge shared &
bridge=$!
trap 'kill "$bridge" 2>/dev/null || true' EXIT
log BRIDGE "Shared-directory bridge PID $bridge"
sleep 1
kill -0 "$bridge" || fail "hardware bridge exited"
echo Q2_BRIDGE_READY
log DEMO "Launching firmware with LD_PRELOAD"
echo Q2_DEMO_ATTEMPT
set +e
Q2EMU_BL_ADDR="$backlight" chroot "$root" /bin/sh -c 'export Q2EMU_DIR=/tmp/q2emu TSLIB_TSDEVICE=/dev/input/event2 TSLIB_CONFFILE=/etc/ts.conf TSLIB_PLUGINDIR=/usr/lib/ts; LD_PRELOAD=/lib/libq2emu.so exec /release/bin/demo'
result=$?
set -e
log DEMO "Exit status $result"
echo "Q2_DEMO_EXIT=$result"
[ ! -f "$root/tmp/q2emu/ioctl.log" ] || cat "$root/tmp/q2emu/ioctl.log"
kill "$bridge" 2>/dev/null || true
exit "$result"
