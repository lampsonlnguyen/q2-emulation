#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
echo "Q2_GUEST_READY"
uname -m
echo "Q2_INIT kernel=$(uname -r)"
cat /proc/cmdline
if grep -qw q2.launch=1 /proc/cmdline; then
    /bin/launch-firmware
    echo "Q2_LAUNCH_RESULT=$?"
fi
echo Q2_GUEST_IDLE
while :; do sleep 3600; done
