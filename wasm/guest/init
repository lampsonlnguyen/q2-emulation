#!/bin/sh
# Keep all startup output on the physical serial console.
exec </dev/console >/dev/console 2>&1
echo Q2_INIT_ENTER
set -x
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
set +x
echo "Q2_GUEST_READY"
uname -m
# A real firmware filesystem may be attached as an IDE disk by the browser harness.
# Only execute it when the user explicitly requests a diagnostic launch.
if grep -qw q2.launch=1 /proc/cmdline; then
    mkdir -p /mnt/q2
    if mount -t squashfs -o ro /dev/sda /mnt/q2 || mount -t squashfs -o ro /dev/hda /mnt/q2; then
        echo "Q2_FIRMWARE_MOUNTED"
        if [ -x /mnt/q2/release/bin/demo ]; then
            echo "Q2_DEMO_ATTEMPT"
            # Diagnostic only: real hardware shim and writable overlay are not yet wired.
            chroot /mnt/q2 /release/bin/demo
            echo "Q2_DEMO_EXIT=$?"
        else
            echo "Q2_DEMO_NOT_FOUND"
        fi
    else
        echo "Q2_FIRMWARE_MOUNT_FAILED"
    fi
fi
echo "Q2_GUEST_IDLE"
# Keep PID 1 alive. Serial is output-only in the initial harness.
while :; do sleep 3600; done
