ARG GUEST_BUILDER=q2-guest-builder:6.6.100-v1
FROM ${GUEST_BUILDER} AS guest
ARG LINUX_VERSION=6.6.100
COPY wasm/guest/init /rootfs/init
COPY wasm/guest/launch-firmware /rootfs/bin/launch-firmware
COPY wasm/guest/hardware-bridge.c /work/hardware-bridge.c
COPY wasm/guest/firmware-patch.c /work/firmware-patch.c
COPY wasm/guest/audio-relay.c /work/audio-relay.c
COPY wasm/guest/wifi-control.c /work/wifi-control.c
COPY emulator/libq2emu.so emulator/libq2emu.so.sha256 emulator/shim.c /work/shim/
RUN cd /work/shim && echo "$(cat libq2emu.so.sha256)  shim.c" | sha256sum -c - && mkdir -p /rootfs/q2 && cp libq2emu.so /rootfs/q2/ && mipsel-linux-gnu-gcc -Wall -Wextra -Werror -O2 -static /work/hardware-bridge.c -o /rootfs/q2/hardware-bridge && mipsel-linux-gnu-gcc -Wall -Wextra -Werror -O2 -static /work/firmware-patch.c -o /rootfs/bin/firmware-patch && mipsel-linux-gnu-gcc -Wall -Wextra -Werror -O2 -static /work/audio-relay.c -o /rootfs/q2/audio-relay && mipsel-linux-gnu-gcc -Wall -Wextra -Werror -O2 -static /work/wifi-control.c -o /rootfs/q2/wifi-control && chmod 755 /rootfs/bin/launch-firmware
RUN chmod 755 /rootfs/init && mkdir -p /rootfs/dev /rootfs/proc /rootfs/sys /rootfs/tmp /rootfs/mnt /rootfs/run /rootfs/etc && mknod /rootfs/dev/console c 5 1 && mknod /rootfs/dev/null c 1 3 && cd /rootfs && find . -print0 | cpio --null -o -H newc | gzip -9 > /out/initramfs.cpio.gz
WORKDIR /work/linux-${LINUX_VERSION}
# Bound RTC calibration for the QEMU Malta 24Kf (320 MHz / CCRes 2).
# Add early IRQ/time markers to distinguish remaining boot stalls.
RUN python3 -c 'exec("from pathlib import Path\np = Path(\"arch/mips/mti-malta/malta-time.c\")\ns = p.read_text()\ndef replace(old, new, count):\n    global s\n    assert s.count(old) == count, old\n    s = s.replace(old, new)\nreplace(\"unsigned int count, start;\", \"unsigned int count, start, polls;\", 1)\nfor condition, count in [(\"CMOS_READ(RTC_REG_A) & RTC_UIP\", 3), (\"!(CMOS_READ(RTC_REG_A) & RTC_UIP)\", 2)]:\n    replace(\"while (\" + condition + \");\", \"for (polls = 0; \" + condition + \"; polls++) {\\n\\t\\tif (polls == 1000000)\\n\\t\\t\\tgoto rtc_timeout;\\n\\t}\", count)\nreplace(\"\\t\\tgic_frequency = giccount;\\n\\t}\\n}\", \"\\t\\tgic_frequency = giccount;\\n\\t}\\n\\treturn;\\nrtc_timeout:\\n\\tlocal_irq_restore(flags);\\n\\tif (mips_gic_present())\\n\\t\\tpanic(\\\"Q2: unexpected GIC during RTC calibration\\\");\\n\\tmips_hpt_frequency = 160000000;\\n\\tpr_warn(\\\"Q2: RTC calibration timed out; using 160 MHz CP0 Count\\\\n\\\");\\n}\", 1)\np.write_text(s)\np = Path(\"init/main.c\")\ns = p.read_text()\nfor call in (\"init_IRQ\", \"time_init\"):\n    old = \"\\n\\t\" + call + \"();\"\n    replace(old, \"\\n\\tpr_info(\\\"Q2_BOOT: \" + call + \" begin\\\\n\\\");\" + old + \"\\n\\tpr_info(\\\"Q2_BOOT: \" + call + \" complete\\\\n\\\");\", 1)\np.write_text(s)\n")'
RUN make ARCH=mips CROSS_COMPILE=mipsel-linux-gnu- malta_defconfig && scripts/config --enable CPU_LITTLE_ENDIAN --disable CPU_BIG_ENDIAN --disable SMP --disable MIPS_MT_SMP --disable MIPS_CPS --enable BINFMT_ELF --enable BINFMT_SCRIPT --enable MIPS_O32_FP64_SUPPORT --enable BLK_DEV_INITRD --enable RD_GZIP --enable DEVTMPFS --enable DEVTMPFS_MOUNT --enable SQUASHFS --enable SQUASHFS_XZ --enable SQUASHFS_ZLIB --enable SQUASHFS_LZO --enable SQUASHFS_LZ4 --enable SQUASHFS_ZSTD --enable BLK_DEV_LOOP --enable DUMMY --enable NET_9P --enable NET_9P_VIRTIO --enable 9P_FS --enable VIRTIO --enable VIRTIO_PCI --enable OVERLAY_FS --enable TMPFS --enable SCSI --enable BLK_DEV_SD --enable ATA --enable ATA_PIIX --enable PATA_MPIIX --enable SERIAL_8250 --enable SERIAL_8250_CONSOLE --disable DEBUG_INFO && make ARCH=mips CROSS_COMPILE=mipsel-linux-gnu- olddefconfig && grep -E 'CONFIG_(CPU_LITTLE_ENDIAN|32BIT|SMP|BINFMT_ELF|BINFMT_SCRIPT|MIPS_O32_FP64_SUPPORT|MIPS_MT_SMP|MIPS_CPS)' .config && grep -qx 'CONFIG_BINFMT_ELF=y' .config && grep -qx 'CONFIG_BINFMT_SCRIPT=y' .config && grep -qx 'CONFIG_MIPS_O32_FP64_SUPPORT=y' .config && grep -qx 'CONFIG_DUMMY=y' .config && grep -qx 'CONFIG_SQUASHFS_LZO=y' .config && grep -qx 'CONFIG_LZO_DECOMPRESS=y' .config && cp .config /out/kernel.config && make ARCH=mips CROSS_COMPILE=mipsel-linux-gnu- -j2 vmlinux && mipsel-linux-gnu-strip -g vmlinux -o /out/vmlinux
FROM scratch
COPY --from=guest /out/ /
